# 客户端配置示例
mode: client

servers:
  - name: cloud
    # 多路径：与服务端 paths 对应，每次连接随机选一个
    urls:
      - "https://云服务器IP:8443/api/v2/sync"
      - "https://云服务器IP:8443/api/v1/metrics"
      - "https://云服务器IP:8443/health/check"
    token: "your-secret-token-change-me"
    insecure: true   # 自签证书时改为 true

# 正向隧道
tunnels:
  - listen: "127.0.0.1:13389"
    server: cloud
    proxy_name: home-to-office

# 反向隧道
expose:
  - name: office-rdp
    backend: "127.0.0.1:3389"
    remote_port: 13389
    server: cloud
