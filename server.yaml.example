# 服务端配置示例
mode: server

listen: "0.0.0.0:8443"

tls:
  enabled: true
  cert_file: "server.crt"
  key_file: "server.key"

token: "your-secret-token-change-me"

# 多路径支持：客户端随机选其中一个，流量分散更自然
paths:
  - "/api/v2/sync"
  - "/api/v1/metrics"
  - "/health/check"

proxies:
  - name: local-rdp
    backend: "127.0.0.1:3389"

  - name: home-to-office
    backend: "@office-rdp"
